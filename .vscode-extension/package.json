{
  "name": "EscapeRoom-Bash",
  "displayName": "EscapeRoom-Bash",
  "description": "Run the Bash Escape Room natively in VS Code - no Docker required. Embedded terminal + MkDocs viewer.",
  "version": "0.6.78",
  "publisher": "nirgeier",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirgeier/Bash-EscapeRoom"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "bash",
    "escape room",
    "terminal",
    "learning",
    "interactive"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bashEscapeRoom.launch",
        "title": "Bash Escape Room: Launch",
        "icon": "$(play)"
      },
      {
        "command": "bashEscapeRoom.stop",
        "title": "Bash Escape Room: Stop",
        "icon": "$(stop-circle)"
      },
      {
        "command": "bashEscapeRoom.openTerminal",
        "title": "Bash Escape Room: Open Terminal Panel",
        "icon": "$(terminal)"
      },
      {
        "command": "bashEscapeRoom.openRoom",
        "title": "Bash Escape Room: Open Current Room",
        "icon": "$(open-preview)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bashEscapeRoom",
          "title": "Bash Escape Room",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "bashEscapeRoom": [
        {
          "type": "webview",
          "id": "bashEscapeRoom.controlPanel",
          "name": "Control Panel"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bashEscapeRoom.launch",
          "when": "view == bashEscapeRoom.controlPanel",
          "group": "navigation@1"
        },
        {
          "command": "bashEscapeRoom.openTerminal",
          "when": "view == bashEscapeRoom.controlPanel",
          "group": "navigation@2"
        },
        {
          "command": "bashEscapeRoom.stop",
          "when": "view == bashEscapeRoom.controlPanel",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Bash Escape Room",
      "properties": {
        "bashEscapeRoom.port": {
          "type": "number",
          "default": 3000,
          "description": "Port the embedded escape room server will listen on."
        },
        "bashEscapeRoom.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open the terminal panel when the server is ready."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "node build.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.27.5",
    "playwright": "^1.59.1",
    "typescript": "^5.3.0"
  }
}
